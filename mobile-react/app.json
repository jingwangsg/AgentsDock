{
  "expo": {
    "name": "AgentsDock",
    "slug": "agentsdock-react",
    "version": "0.1.1",
    "scheme": "com.zhengyiluo.ZenithDock",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zhengyiluo.ZenithDock",
      "buildNumber": "171",
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": []
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "AgentsDock connects to your private agent server on your LAN or Tailscale network.",
        "UIRequiresFullScreen": false
      }
    },
    "android": {
      "package": "com.zhengyiluo.agentsdock",
      "versionCode": 55,
      "usesCleartextTraffic": true,
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withIosNoAnalyticsPrivacy.cjs",
      "./plugins/withAndroidCleartextTraffic.cjs",
      "./plugins/withAndroidReleaseSigning.cjs",
      "./plugins/withAndroidSideloadUpdater.cjs",
      "./plugins/withAndroidPreparedTextLayout.cjs",
      "./plugins/withAndroidAsyncStorageSize.cjs",
      "expo-secure-store",
      "expo-sharing",
      "expo-video",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AgentsDock to access photos you choose to attach to agent messages.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#2563EB",
          "defaultChannel": "default"
        }
      ],
      "expo-document-picker",
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/ibm-plex-sans/IBMPlexSans-Regular.ttf",
              "./assets/fonts/ibm-plex-sans/IBMPlexSans-Italic.ttf",
              "./assets/fonts/ibm-plex-sans/IBMPlexSans-SemiBold.ttf",
              "./assets/fonts/ibm-plex-sans/IBMPlexSans-SemiBoldItalic.ttf",
              "./assets/fonts/lilex/Lilex-Regular.ttf",
              "./assets/fonts/lilex/Lilex-Italic.ttf",
              "./assets/fonts/lilex/Lilex-Bold.ttf",
              "./assets/fonts/lilex/Lilex-BoldItalic.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "IBM Plex Sans",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/ibm-plex-sans/IBMPlexSans-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/ibm-plex-sans/IBMPlexSans-Italic.ttf",
                    "weight": 400,
                    "style": "italic"
                  },
                  {
                    "path": "./assets/fonts/ibm-plex-sans/IBMPlexSans-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/ibm-plex-sans/IBMPlexSans-SemiBoldItalic.ttf",
                    "weight": 600,
                    "style": "italic"
                  }
                ]
              },
              {
                "fontFamily": "Lilex",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/lilex/Lilex-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/lilex/Lilex-Italic.ttf",
                    "weight": 400,
                    "style": "italic"
                  },
                  {
                    "path": "./assets/fonts/lilex/Lilex-Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/lilex/Lilex-BoldItalic.ttf",
                    "weight": 700,
                    "style": "italic"
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "android": {
            "backgroundColor": "#2f343e",
            "image": "./assets/android-icon-foreground.png",
            "imageWidth": 200
          }
        }
      ]
    ]
  }
}
