+// Yoga lays out in float, so a frame can come out a hair (about 1e-4 pt) under the size the text was measured
+// at. TextKit then has no room for the last line: it drops it and truncates the line before with an ellipsis.
+// The text view gets the frame rounded up to whole pixels when it is that close to the next pixel.
+- (CGRect)textViewFrame
+{
+  const CGFloat scale = RCTScreenScale();
+  CGRect frame = _view.frame;
+  frame.size.width = ceil(frame.size.width * scale - 0.01) / scale;
+  frame.size.height = ceil(frame.size.height * scale - 0.01) / scale;
+  return frame;
+}
+
 - (void)layoutSubviews
 {
   [super layoutSubviews];
